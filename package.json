{
  "name": "deedlit.dev.ui-workspace",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "format": "biome format .",
    "format:write": "biome format . --write",
    "check": "biome check .",
    "build": "pnpm --filter @carneirofc/ui build",
    "storybook": "pnpm --filter @carneirofc/ui storybook",
    "build-storybook": "pnpm --filter @carneirofc/ui build-storybook"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14"
  }
}
