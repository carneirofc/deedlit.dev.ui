{
  "name": "deedlit.dev.comfyhelper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:ui": "npm run build --prefix ../deedlit.dev.ui",
    "dev": "docker compose up -d redis && next dev",
    "build": "npm run build:ui && next build",
    "start": "node ./scripts/start-production.mjs",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@carneirofc/ui": "file:../deedlit.dev.ui",
    "@editorjs/editorjs": "^2.31.7",
    "@editorjs/header": "^2.8.9",
    "@editorjs/list": "^2.0.9",
    "@editorjs/paragraph": "^2.11.7",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation-aws-sdk": "^0.77.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@qdrant/js-client-rest": "^1.19.0",
    "@vercel/otel": "^2.1.3",
    "clsx": "^2.1.1",
    "cytoscape": "^3.34.3",
    "ioredis": "^6.0.0",
    "neo4j-driver": "^6.2.0",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^7"
  }
}
