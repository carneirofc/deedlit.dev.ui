# Copy to .env.local for local development.
#
# Register a GitHub OAuth app with the callback URL
#   http://localhost:3001/api/auth/callback/github
# GitHub allows one callback URL per app, so use a separate app from production.

# Signs the session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET=

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Required behind a reverse proxy (Traefik in the cluster); harmless locally.
AUTH_TRUST_HOST=true

# --- Who may sign in ----------------------------------------------------
# The check fails closed: if neither of these is set, NOBODY can sign in.

# Only active members of this GitHub organization are admitted.
AUTH_ALLOWED_GITHUB_ORG=

# Optional: narrow to a team within that org (team slug).
AUTH_ALLOWED_GITHUB_TEAM=

# Optional: comma-separated logins allowed alongside the org check. Useful
# before an org exists.
AUTH_ALLOWED_GITHUB_USERS=carneirofc
