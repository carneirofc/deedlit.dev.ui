{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",

  // One config for the whole monorepo. Biome replaced ESLint: `deedlit.dev`
  // ran `next lint`, which Next 16 removed, and comfyhelper had its own
  // eslint-config-next flat config. Neither package needs a linter config of
  // its own now — do not add one back.

  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },

  "files": {
    "ignoreUnknown": true,
    // Folder ignores intentionally have no trailing `/**` — Biome >= 2.2
    // treats the bare path as the folder, and the old form is itself linted
    // (suspicious/useBiomeIgnoreFolder).
    "includes": [
      "**",
      "!**/.next",
      "!**/out",
      "!**/build",
      "!**/dist",
      "!**/storybook-static",
      "!**/next-env.d.ts",
      "!**/playwright-report",
      "!**/test-results",
      "!**/coverage",
      "!deedlit.dev.comfyhelper/lib/generated",
      "!deedlit.dev.comfyhelper/library",
      "!**/*.min.js",
      "!pnpm-lock.yaml",
      // Generated by Structurizr from workspace.dsl.
      "!docs/architecture/workspace.json"
    ]
  },

  // Applied to the whole tree; the pre-commit hook keeps staged files
  // formatted. Values match .editorconfig.
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },

  // Tailwind v4 uses @source/@theme/@utility/@apply, which Biome's CSS parser
  // rejects unless this is on. Without it every globals.css is a parse error.
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "none",
      "arrowParentheses": "always"
    }
  },

  // Aggressive by design: every stable rule is on ("all" preset), plus the
  // type-aware promise rules from nursery. What is switched off below is
  // switched off because it targets another framework (Solid, Qwik, Preact),
  // contradicts how React/Next code is written, or duplicates `tsc` — not
  // because it is inconvenient. Turning a rule off needs a reason here.
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",

      "complexity": {
        // Used deliberately to mark fire-and-forget promises, which
        // nursery/noFloatingPromises asks for. The two rules conflict.
        "noVoid": "off",
        "noExcessiveCognitiveComplexity": "warn",
        "noExcessiveLinesPerFunction": "warn"
      },

      "correctness": {
        // Other frameworks' rules; "all" enables them regardless of domain.
        "noSolidDestructuredProps": "off",
        "useQwikValidLexicalScope": "off",
        // False positives on CJS `export =` typings (react, pino,
        // @playwright/test). `tsc` already rejects unresolved imports.
        "noUnresolvedImports": "off",
        // Bundler/Next module resolution; extensions are added at build time
        // (deedlit.dev.ui/scripts/fix-esm-imports.mjs).
        "useImportExtensions": "off",
        // Server routes are Node by definition, and `node:process` breaks
        // Next's inlining of process.env.NEXT_PUBLIC_* in client bundles.
        "noNodejsModules": "off",
        "noProcessGlobal": "off"
      },

      "performance": {
        "useSolidForComponent": "off",
        // Inline handlers are idiomatic React; the React Compiler memoises.
        "noJsxPropsBind": "off"
      },

      "style": {
        // React renders conditionally with ternaries; banning them is not an
        // option in JSX.
        "noTernary": "off",
        // i18n-only rule; this UI is not localised.
        "noJsxLiterals": "off",
        // Design tokens and Tailwind arbitrary values are literal by nature.
        "noHexColors": "off",
        "noMagicNumbers": "off",
        // Bare boolean props (`asChild`, `disabled`) are idiomatic JSX; the
        // "fix" rewrites them to `={true}`.
        "noImplicitBoolean": "off",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case", "PascalCase", "camelCase"]
          }
        }
      },

      "suspicious": {
        // Preact/Solid rule: flags `className`, which React requires.
        "noReactSpecificProps": "off"
      },

      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      }
    },

    // Biome infers these from package.json, but pinning them means a
    // dependency change cannot silently switch off the Next/React rules that
    // replaced eslint-config-next.
    "domains": {
      "next": "all",
      "react": "all",
      "test": "all"
    }
  },

  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedKeys": "off"
      }
    }
  },

  "overrides": [
    {
      // Module augmentation (e.g. src/types/next-auth.d.ts) legitimately
      // widens third-party types.
      "includes": ["**/*.d.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      // Storybook names stories after the state they show, so `export const
      // Error` shadows the global by design and is never called as one.
      // Stories also require a default export (the CSF meta).
      "includes": ["**/*.stories.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noShadowRestrictedNames": "off"
          },
          "style": {
            "noDefaultExport": "off",
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    },
    {
      // Next.js file conventions (page, layout, route segments, proxy) and
      // tool configs are required to default-export; layouts and pages also
      // export `metadata`/`viewport` next to the component.
      "includes": [
        "**/app/**/*.{ts,tsx}",
        "**/proxy.ts",
        "**/instrumentation.ts",
        "**/*.config.{js,mjs,cjs,ts}",
        "**/.storybook/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    },
    {
      // Static SVG assets are loaded through <img>, where an inner <title>
      // is never exposed; the alt text on the <img> is what counts.
      "includes": ["**/*.svg"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    },
    {
      // The package entry point is a barrel on purpose: it is the public API.
      "includes": ["deedlit.dev.ui/src/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off",
            "noReExportAll": "off"
          }
        }
      }
    },
    {
      // Build and tooling scripts are CommonJS by necessity, not by drift.
      "includes": ["**/scripts/**", "**/*.config.{js,mjs,ts}", "**/postcss.config.js"],
      "linter": {
        "rules": {
          "style": {
            "noCommonJs": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
