{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",

  // One config for the whole repo. Biome replaced ESLint — do not add a
  // per-package linter config back.

  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },

  "files": {
    "ignoreUnknown": true,
    // Folder ignores intentionally have no trailing `/**` — Biome >= 2.2
    // treats the bare path as the folder, and the old form is itself linted
    // (suspicious/useBiomeIgnoreFolder).
    "includes": [
      "**",
      "!**/.next",
      "!**/out",
      "!**/build",
      "!**/dist",
      "!**/storybook-static",
      "!**/next-env.d.ts",
      "!**/playwright-report",
      "!**/test-results",
      "!**/coverage",
      "!**/*.min.js",
      "!pnpm-lock.yaml"
    ]
  },

  // Configured and usable (`pnpm format`), but deliberately NOT applied to
  // the tree: it rewrites ~230 of 318 files. That belongs in its own commit,
  // not smuggled in alongside a behaviour change. Values match .editorconfig.
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },

  // Tailwind v4 uses @source/@theme/@utility/@apply, which Biome's CSS parser
  // rejects unless this is on. Without it every globals.css is a parse error.
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "none",
      "arrowParentheses": "always"
    }
  },

  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",

      // Biome's a11y set is far wider than the six jsx-a11y rules
      // eslint-config-next enabled, and those six were warnings. Demoting the
      // extras keeps the migration from silently raising the bar to where CI
      // cannot pass; they stay visible as warnings and are the backlog.
      "a11y": {
        "useButtonType": "warn",
        "noSvgWithoutTitle": "warn",
        "noStaticElementInteractions": "warn",
        "noLabelWithoutControl": "warn",
        "noNoninteractiveElementToInteractiveRole": "warn",
        "useKeyWithClickEvents": "warn",
        "useSemanticElements": "warn",
        "useValidAnchor": "warn",
        "useFocusableInteractive": "warn",
        "useAnchorContent": "warn",
        "noRedundantAlt": "warn"
      },

      // docs/agents/code-style.md: functions ~40 lines, components ~60 (see
      // the *.tsx override). Biome only has cognitive complexity, not
      // cyclomatic; 15 is its default and roughly matches cyclomatic 10.
      "complexity": {
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": { "maxLines": 40, "skipBlankLines": true }
        },
        // Warn, not error: five existing functions score 16-22. They are the
        // backlog, same as the a11y warnings above.
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": { "maxAllowedComplexity": 15 }
        }
      },

      "correctness": {
        // Was react-hooks/exhaustive-deps, a warning under eslint-config-next.
        // Same severity here, so the migration changes nothing.
        "useExhaustiveDependencies": "warn"
      },

      "style": {
        // Not enforced by the previous config; flags existing deliberate
        // assertions rather than new defects.
        "noNonNullAssertion": "warn"
      },

      "suspicious": {
        // Every current hit was reviewed and is keyed by position on purpose:
        // fixed-length placeholder slots, static text lists that are never
        // reordered, or `${item}-${index}` where the item already discriminates.
        // Left visible so a genuinely unstable key still gets noticed.
        "noArrayIndexKey": "warn"
      }
    },

    // Biome infers these from package.json, but pinning them means a
    // dependency change cannot silently switch off the Next/React rules that
    // replaced eslint-config-next.
    "domains": {
      "next": "recommended",
      "react": "recommended",
      "test": "recommended"
    }
  },

  // Code-style rules from docs/agents/code-style.md that Biome has no built-in
  // rule for. noExplicitAny is already on through the recommended preset.
  "plugins": ["./biome-plugins/no-hand-written-types.grit"],

  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        // Off on purpose: reordering imports across the repo is a formatting
        // change in disguise, and the same reasoning as the formatter applies.
        "organizeImports": "off"
      }
    }
  },

  "overrides": [
    {
      // Components get ~60 lines instead of ~40 (docs/agents/code-style.md).
      "includes": ["**/*.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "error",
              "options": { "maxLines": 60, "skipBlankLines": true }
            }
          }
        }
      }
    },
    {
      // Size rules are relaxed in tests, stories and e2e, as they were under
      // ESLint: test bodies are long by nature. The hand-written-type plugin
      // exempts the same paths itself (see the .grit file).
      "includes": [
        "**/tests/**",
        "**/e2e/**",
        "**/*.test.{ts,tsx}",
        "**/*.unit.ts",
        "**/*.stories.tsx"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off",
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      // Module augmentation (e.g. src/types/next-auth.d.ts) legitimately
      // widens third-party types.
      "includes": ["**/*.d.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      // Storybook names stories after the state they show, so `export const
      // Error` shadows the global by design and is never called as one.
      "includes": ["**/*.stories.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noShadowRestrictedNames": "off"
          }
        }
      }
    },
    {
      // Build and tooling scripts are CommonJS by necessity, not by drift.
      "includes": ["**/scripts/**", "**/*.config.{js,mjs,ts}", "**/postcss.config.js"],
      "linter": {
        "rules": {
          "style": {
            "noCommonJs": "off"
          }
        }
      }
    }
  ]
}
